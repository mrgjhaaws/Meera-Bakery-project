# =============================================================================
# Meera Bakery — .env.example
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# In production (EC2), these values are injected by the systemd EnvironmentFile
# or populated from AWS Secrets Manager before the service starts.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local development: use localhost (MySQL in Docker or local install)
# EC2 production: use the private RDS endpoint DNS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meera_bakery

# Least-privilege application DB user (SELECT, INSERT, UPDATE, DELETE only)
# Create with: CREATE USER 'meera_app'@'%' IDENTIFIED BY '...';
#              GRANT SELECT, INSERT, UPDATE, DELETE ON meera_bakery.* TO 'meera_app'@'%';
DB_USER=meera_app

# REPLACE THIS — never store the real password here
# On EC2, populate from: aws secretsmanager get-secret-value --secret-id meera-bakery-db
DB_PASSWORD=REPLACE_WITH_SECRET

# Connection pool size per application instance
# Two EC2 instances × 5 = 10 total connections to RDS
DB_POOL_SIZE=5

# --- Application -------------------------------------------------------------
# local | production
APP_ENV=local

# DEBUG for local dev, INFO for production
LOG_LEVEL=DEBUG

# Application port (Uvicorn listens here; ALB forwards to this port on EC2)
APP_PORT=8000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins
# Local: http://localhost:3000 (if you add a frontend)
# Production: set to the ALB DNS or your custom domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- AWS SNS (order notifications) — optional, OFF by default ----------------
# No access keys go here. On EC2, boto3 uses the instance's IAM role
# automatically (attach an IAM policy allowing sns:Publish).
AWS_REGION=ap-south-1

# Set true only after creating the SNS topic(s) and, for real SMS, exiting
# the SNS sandbox / completing TRAI DLT registration (India). False = no
# AWS calls are made; order notifications are just logged.
SNS_NOTIFICATIONS_ENABLED=false

# Topic ARN for bakery-admin alerts (e.g. low-stock). Leave blank until
# you've created the topic.
SNS_ADMIN_TOPIC_ARN=

# --- AWS SES (OTP login emails) — optional, OFF by default --------------------
# Same IAM-role pattern as SNS above — no access keys here.
# SES has a real free tier (62,000 emails/month from EC2); SNS SMS does not,
# which is why login uses email+SES instead of SMS+SNS.
SES_ENABLED=false

# Must be a verified SES sender identity (single address or whole domain).
# Required when SES_ENABLED=true.
SES_SENDER_EMAIL=

# How long an OTP code stays valid, and how many wrong attempts are allowed
# before that code is locked out.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Minimum seconds between two OTP requests for the same email (anti-spam).
OTP_REQUEST_COOLDOWN_SECONDS=60

# --- JWT session tokens (issued after OTP verification) ----------------------
# MUST be overridden in production — the app refuses to start with this
# default value when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# How long an issued access token stays valid (minutes). Default: 7 days.
JWT_EXPIRY_MINUTES=10080
