# =============================================================================
# Meera Bakery — .env.example
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# In production (EC2), these values are injected by the systemd EnvironmentFile
# or populated from AWS Secrets Manager before the service starts.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local development: use localhost (MySQL in Docker or local install)
# EC2 production: use the private RDS endpoint DNS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meera_bakery

# Least-privilege application DB user (SELECT, INSERT, UPDATE, DELETE only)
# Create with: CREATE USER 'meera_app'@'%' IDENTIFIED BY '...';
#              GRANT SELECT, INSERT, UPDATE, DELETE ON meera_bakery.* TO 'meera_app'@'%';
DB_USER=meera_app

# REPLACE THIS — never store the real password here
# On EC2, populate from: aws secretsmanager get-secret-value --secret-id meera-bakery-db
DB_PASSWORD=REPLACE_WITH_SECRET

# Connection pool size per application instance
# Two EC2 instances × 5 = 10 total connections to RDS
DB_POOL_SIZE=5

# --- Application -------------------------------------------------------------
# local | production
APP_ENV=local

# DEBUG for local dev, INFO for production
LOG_LEVEL=DEBUG

# Application port (Uvicorn listens here; ALB forwards to this port on EC2)
APP_PORT=8000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins
# Local: http://localhost:3000 (if you add a frontend)
# Production: set to the ALB DNS or your custom domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
