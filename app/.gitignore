# =============================================================================
# Meera Bakery — .gitignore
# =============================================================================

# --- Environment & secrets (NEVER commit these) ------------------------------
.env
.env.local
.env.production
*.env

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual environments ----------------------------------------------------
venv/
env/
.venv/
.env/
ENV/

# --- Distribution / packaging ------------------------------------------------
dist/
build/
*.egg-info/
*.egg
.eggs/

# --- Testing & coverage ------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.coveragerc
.tox/

# --- IDE / editor ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- Certificates (keep the CA cert template, not any private keys) ----------
*.pem
*.key
*.crt
!rds-ca.pem.example

# --- mypy / type checkers ----------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
